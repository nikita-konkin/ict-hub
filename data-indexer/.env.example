# Data Indexer Service Environment Variables
# Copy this to your main .env file or create a separate .env file for the data-indexer service

# Data Indexer Paths - Configure these to point to your data directories
# Host paths (where data is stored on your machine)
INDEXER_RINEX_DATA_PATH_HOST=F:\GNSS\Data\RINEX
INDEXER_TECSUITE_OUT_DAT_DATA_PATH_HOST=F:\GNSS\Data\TEC-Suite\Output
INDEXER_ABSTEC_OUTPUT_DATA_PATH_HOST=F:\GNSS\Data\AbsTEC\Output
INDEXER_PARQUET_OUTPUT_TECSUITE_DATA_PATH_HOST=F:\GNSS\Data\TEC-Suite\Parquet
INDEXER_PARQUET_OUTPUT_ABSTEC_DATA_PATH_HOST=F:\GNSS\Data\AbsTEC\Parquet

# Container paths (where data is mounted inside the container - usually don't need to change)
INDEXER_RINEX_DATA_PATH_CONTAINER=/mnt/rinex-server
INDEXER_TECSUITE_OUT_DAT_DATA_PATH_CONTAINER=/mnt/tecsuite-out
INDEXER_ABSTEC_OUTPUT_DATA_PATH_CONTAINER=/mnt/abstec-out
INDEXER_PARQUET_OUTPUT_TECSUITE_DATA_PATH_CONTAINER=/mnt/tecsuite-parquet-out
INDEXER_PARQUET_OUTPUT_ABSTEC_DATA_PATH_CONTAINER=/mnt/abstec-parquet-out