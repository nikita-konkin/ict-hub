# Data Indexer Service Environment Variables
# This service is deployed as part of the main ict-hub docker-compose.yml and
# shares its .env with converter-hub — see ../.env.example for the actual
# values used in that setup. This file only documents standalone use.

# Data Indexer Paths - Configure these to point to your data directories
# Host paths (where data is stored on your machine) — shared with converter-hub.
RINEX_DATA_PATH_HOST=F:\GNSS\Data\RINEX
TECSUITE_OUT_DAT_DATA_PATH_HOST=F:\GNSS\Data\TEC-Suite\Output
ABSTEC_OUTPUT_DATA_PATH_HOST=F:\GNSS\Data\AbsTEC\Output
PARQUET_OUTPUT_TECSUITE_DATA_PATH_HOST=F:\GNSS\Data\TEC-Suite\Parquet
PARQUET_OUTPUT_ABSTEC_DATA_PATH_HOST=F:\GNSS\Data\AbsTEC\Parquet

# Container paths (where data is mounted inside the container) — also shared
# with converter-hub's own vars of the same name, so both services always
# agree on where each data type lives. Usually don't need to change.
RINEX_DATA_PATH_CONTAINER=/mnt/rinex-server
TECSUITE_OUT_DAT_DATA_PATH_CONTAINER=/mnt/tecsuite-out
ABSTEC_OUTPUT_DATA_PATH_CONTAINER=/mnt/abstec-out
PARQUET_OUTPUT_TECSUITE_DATA_PATH_CONTAINER=/mnt/tecsuite-parquet-out
PARQUET_OUTPUT_ABSTEC_DATA_PATH_CONTAINER=/mnt/abstec-parquet-out

# Data Indexer Configuration
# Cache time-to-live in seconds (how often to rescan directories for new files)
# Default: 300.0 (5 minutes). Lower = more frequent updates, higher = better performance
DATA_INDEXER_CACHE_TTL_SEC=300.0

# Path to persistent cache database (SQLite)
# Default: /app/data/cache.db. Mount as volume to persist across container restarts
DATA_INDEXER_CACHE_DB_PATH=/app/data/cache.db

# Run initial indexing on container startup
# Options: false (default), true/async (non-blocking), sync (blocking, requires rebuild)
# Default: false. Set to 'true' for production to reduce first-request latency
DATA_INDEXER_RUN_ON_STARTUP=false

# Minimum age of the previous full index before startup indexing runs again.
# Restarting the service is cheap, re-walking the whole RINEX tree is not, so a
# restart within this window is refused and logged instead of rescanning.
# Wall-clock seconds; default 86400 (1 day). Set 0 to always index on startup.
DATA_INDEXER_MIN_REINDEX_INTERVAL_SEC=86400