# Copy this file to .env and adjust values for local development.
# In production (Docker), set these via docker-compose.yml environment section.

# IMPORTANT: generate a real random key before going into production.
# Python: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-random-32-char-string!!

# Default admin password created on first boot. Change it via the Users page.
ADMIN_PASSWORD=admin

# SQLite database path. The directory must be writable.
# In Docker this is a named volume; locally you can use any path.
DATABASE_URL=sqlite:///./dev.db

# Docker image name for the tecsuite container.
TECSUITE_IMAGE=tec-suite

# Max number of log lines kept in the browser UI per job panel.
# Increase if you need more history, decrease to reduce RAM/CPU usage in the browser.
LOG_MAX_LINES=2000

# On a full page render (browser reload / opening an existing job panel), only
# request the last N log lines from the SSE endpoint to avoid loading huge
# histories. Set to 0 to skip replay and only stream new logs.
LOG_PAGELOAD_TAIL_LINES=200

# If enabled, pages will scan Docker for running converter containers (by image/labels)
# and import missing ones into the database. Useful after an ict-hub rebuild/reset.
DISCOVER_RUNNING_CONTAINERS=1
