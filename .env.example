# Copy this file to .env and adjust values for local development.
# In production (Docker), set these via docker-compose.yml environment section.

# IMPORTANT: generate a real random key before going into production.
# Python: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-random-32-char-string!!

# Default admin password created on first boot. Change it via the Users page.
ADMIN_PASSWORD=admin

# Host port converter-hub is published on (container always listens on 8000).
# Override if 8080 is already taken on this host (e.g. by another web app).
CONVERTER_HUB_HOST_PORT=8080

# SQLite database path. The directory must be writable.
#
# Docker-compose default uses a named volume at /app/data:
#   sqlite:////app/data/converter_hub.db
#
# If you need to override the DB URL for docker-compose, set:
#   CONVERTER_HUB_DATABASE_URL=sqlite:////app/data/converter_hub.db
#
# If you run the FastAPI app directly on the host (non-Docker), set DATABASE_URL
# to a host path, for example:
#   DATABASE_URL=sqlite:///./dev.db

# Docker image names for the containers converter-hub launches via the Docker
# socket. Defaults point at Docker Hub (nikitaikonkin/...); override only if
# you build these locally under a different tag.
TECSUITE_IMAGE=nikitaikonkin/tec-suite:latest
DAT_PARQUET_IMAGE=nikitaikonkin/dat-parquet-handler:latest
ABSTEC_SUITE_IMAGE=nikitaikonkin/abstec-suite:latest

# Tag to deploy for converter-hub / data-indexer themselves (see IMAGE_TAG in
# docker-compose.yml). Bump this on the server when rolling out a new release.
IMAGE_TAG=latest

# How often (seconds) the watchtower service checks Docker Hub for newer
# images of converter-hub / data-indexer / tec-backend and auto-restarts them.
WATCHTOWER_POLL_INTERVAL=300

# TEC Map basemap — HTTP XYZ tile server.
# URL template with {z}/{x}/{y} placeholders. Example for a local
# overv/openstreetmap-tile-server container exposed on host port 8090:
#   http://host.docker.internal:8090/tile/{z}/{x}/{y}.png
# Leave empty to disable the "XYZ tile server (HTTP)" basemap option.
TEC_MAP_BASEMAP_TILE_SERVER_URL=

# Data-indexer service URL (inside docker-compose network)
DATA_INDEXER_URL=http://data-indexer:5001
# Timeout for converter-hub -> data-indexer requests (seconds)
DATA_INDEXER_TIMEOUT_SEC=120

# Data-indexer tuning (read by data-indexer service)
# Disable watchers if your dataset is huge or you hit Linux inotify limits.
DATA_INDEXER_WATCHERS_ENABLED=true
# Limit indexing to newest N years (0 = unlimited).
DATA_INDEXER_MAX_YEARS=0

# Max number of log lines kept in the browser UI per job panel.
# Increase if you need more history, decrease to reduce RAM/CPU usage in the browser.
LOG_MAX_LINES=2000

# On a full page render (browser reload / opening an existing job panel), only
# request the last N log lines from the SSE endpoint to avoid loading huge
# histories. Set to 0 to skip replay and only stream new logs.
LOG_PAGELOAD_TAIL_LINES=200

# If enabled, pages will scan Docker for running converter containers (by image/labels)
# and import missing ones into the database. Useful after an ict-hub rebuild/reset.
DISCOVER_RUNNING_CONTAINERS=1
